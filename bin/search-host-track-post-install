#!/usr/bin/env bash
# Host-track / local-safe install for the Search app (semantic-only).
# JS deps via npm so sharp's native postinstall runs (@xenova/transformers).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd -P)"
cd "$ROOT"

if command -v npm >/dev/null 2>&1; then
  npm install --omit=dev
elif command -v bun >/dev/null 2>&1; then
  echo "search-host-track-post-install: npm missing; trying bun (sharp may break)" >&2
  bun install
  bun pm trust --all 2>/dev/null || true
else
  echo "search-host-track-post-install: need npm or bun for JS deps" >&2
  exit 127
fi

if command -v bun >/dev/null 2>&1; then
  bun install --dev 2>/dev/null || true
fi

# Bundle local TypeScript for Node; neural native code runs under Node as well.
if ! command -v bun >/dev/null 2>&1; then
  echo "search-host-track-post-install: Bun is required to build the Node CLI" >&2
  exit 127
fi
if ! command -v node >/dev/null 2>&1; then
  echo "search-host-track-post-install: Node is required to run Search" >&2
  exit 127
fi
bun build src/cli.ts --target=node --packages=external --outfile=bin/search-cli.mjs

# Optional native-model deployment check. Keep the existing skip control.
if [ "${SEARCH_SKIP_NEURAL_SMOKE:-0}" != "1" ]; then
  if node --input-type=module -e '
    import { pipeline } from "@xenova/transformers";
    const embed = await pipeline("feature-extraction", "Xenova/all-MiniLM-L6-v2");
    const result = await embed("Search initialization", { pooling: "mean", normalize: true });
    if (result.data.length !== 384) {
      console.error("bad dimensions", result.data.length);
      process.exit(1);
    }
    console.log("search-host-track-post-install: neural MiniLM ready (384 dimensions)");
  '; then
    :
  else
    echo "search-host-track-post-install: WARN neural model initialization failed" >&2
  fi
fi

echo "search-host-track-post-install: OK (bin/search + JS deps; semantic-only)"
